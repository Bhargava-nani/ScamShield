{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScamShield DataForge Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "source_url",
    "permission_confirmed",
    "license_status",
    "approval_status",
    "retrieved_at"
  ],
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "permission_confirmed": {
      "type": "boolean"
    },
    "license_status": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "approval_status": {
      "type": "string",
      "enum": ["PENDING", "VALIDATED", "REJECTED", "QUARANTINED"]
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider": {
      "type": ["string", "null"],
      "maxLength": 256
    },
    "retrieved_sha256": {
      "type": ["string", "null"],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "retrieved_bytes": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "data_type": {
      "type": "string",
      "enum": ["REAL", "SYNTHETIC"]
    },
    "processing_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["operation", "timestamp"],
        "properties": {
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "details": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  }
}